---
---
<footer class="theme-bg border-t theme-border pt-16 pb-24 text-xs theme-body">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 pb-12 border-b theme-border">
      
      <!-- Brand column -->
      <div class="col-span-2 space-y-4">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full border border-white/20 p-0.5 shadow-xl shadow-slate-950/40 flex items-center justify-center shrink-0">
            <svg class="w-full h-full text-white" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="footerMetallicGradientLarge" x1="0%" y1="100%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#0b0d14" />
                  <stop offset="40%" stop-color="#1e2230" />
                  <stop offset="100%" stop-color="#858b9c" />
                </linearGradient>
              </defs>
              <circle cx="32" cy="32" r="30" fill="url(#footerMetallicGradientLarge)" />
              <rect x="17" y="17" width="30" height="30" rx="7" transform="rotate(22.5 32 32)" fill="none" stroke="#ffffff" stroke-width="5" stroke-linejoin="round" />
              <circle cx="32" cy="32" r="5" fill="#ffffff" />
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xl sm:text-2xl font-black theme-heading tracking-tight leading-none">Pixel Focal</span>
            <span class="text-[10px] sm:text-xs font-mono text-blue-500 font-bold tracking-wider mt-0.5">BROWSER IMAGE SUITE</span>
          </div>
        </div>
        <p class="text-xs theme-body max-w-sm leading-relaxed">
          Premium, modern image utilities platform inspired by Vercel, Linear, and Raycast. Powered by HTML5 Canvas and WebAssembly.
        </p>
        <div class="flex flex-wrap items-center gap-1.5 pt-1 text-[11px] font-medium">
          <span class="px-2.5 py-1 rounded-lg theme-card border theme-border theme-heading flex items-center gap-1">🔒 Privacy First</span>
          <span class="px-2.5 py-1 rounded-lg theme-card border theme-border theme-heading flex items-center gap-1">⚡ Runs in Browser</span>
          <span class="px-2.5 py-1 rounded-lg theme-card border theme-border theme-heading flex items-center gap-1">🚫 No Uploads</span>
          <span class="px-2.5 py-1 rounded-lg theme-card border theme-border theme-heading flex items-center gap-1">🌍 Works Offline</span>
        </div>
      </div>

      <!-- Links Column 1: Tools Workspace -->
      <div>
        <h4 class="font-bold theme-heading text-xs mb-3 uppercase tracking-wider">Image Tools</h4>
        <ul class="space-y-2">
          <li><a href="/tools/image-resizer" class="hover:text-blue-500 transition-colors">Image Resizer</a></li>
          <li><a href="/tools/image-cropper" class="hover:text-blue-500 transition-colors">Image Cropper</a></li>
          <li><a href="/tools/image-compressor" class="hover:text-blue-500 transition-colors">Image Compressor</a></li>
          <li><a href="/tools/image-converter" class="hover:text-blue-500 transition-colors">Image Converter</a></li>
          <li><a href="/tools/watermark-tool" class="hover:text-blue-500 transition-colors">Watermark Tool</a></li>
        </ul>
      </div>

      <!-- Links Column 2: Company & Legal MPA Routes -->
      <div>
        <h4 class="font-bold theme-heading text-xs mb-3 uppercase tracking-wider">Company & Legal</h4>
        <ul class="space-y-2">
          <li><a href="/about" class="hover:text-blue-500 transition-colors font-medium">About Us</a></li>
          <li><a href="/privacy" class="hover:text-blue-500 transition-colors font-medium">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-blue-500 transition-colors font-medium">Terms & Conditions</a></li>
          <li><a href="/contact" class="hover:text-blue-500 transition-colors font-medium">Contact Us</a></li>
          <li><a href="/#faq" class="hover:text-blue-500 transition-colors">FAQ & Docs</a></li>
        </ul>
      </div>

    </div>

    <!-- Copyright & Legal Footer Strip -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 theme-muted">
      <p>© 2026 Pixel Focal. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="/about" class="hover:text-blue-500 transition-colors">About</a>
        <a href="/privacy" class="hover:text-blue-500 transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-blue-500 transition-colors">Terms</a>
        <a href="/contact" class="hover:text-blue-500 transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
