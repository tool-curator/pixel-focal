---
const featureList = [
  {
    toolId: 'resize',
    title: '100% Privacy First',
    desc: 'All operations happen inside your browser runtime. Zero images, metadata, or buffers ever touch a remote server.',
    icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
    tag: 'SECURITY'
  },
  {
    toolId: 'resize',
    title: 'Lightning Fast WASM & Canvas',
    desc: 'Powered by HTML5 Canvas and WebAssembly codecs for zero-latency image processing and instant preview rendering.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
    tag: 'PERFORMANCE'
  },
  {
    toolId: 'batch',
    title: 'Batch Processing Queue',
    desc: 'Queue multiple images simultaneously, apply uniform resize, compression, and watermarks, then download as a ZIP archive.',
    icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
    tag: 'WORKFLOW'
  },
  {
    toolId: 'crop',
    title: 'Smart Focal Point Crop',
    desc: 'Interactive freeform drag-to-crop overlay and presets for 1:1, 4:5, 16:9, 9:16, and 21:9 aspect ratios.',
    icon: 'M5 3v14a2 2 0 002 2h14M3 5h14a2 2 0 012 2v14',
    tag: 'DESIGN'
  },
  {
    toolId: 'responsive',
    title: 'Responsive Code Snippets',
    desc: 'Auto-generate production ready HTML <picture>, srcset, Next.js <Image>, Astro, React, and Vue code.',
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
    tag: 'DEV TOOLS'
  },
  {
    toolId: 'palette',
    title: 'Color Palette Extraction',
    desc: 'Extract dominant color palettes directly from image pixels with instant HEX code copy shortcuts.',
    icon: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
    tag: 'UTILITIES'
  },
  {
    toolId: 'metadata',
    title: 'Metadata Cleanup & EXIF Strip',
    desc: 'Inspect camera EXIF, GPS location, timestamp, and ISO tags, then sanitize images for safe public web sharing.',
    icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    tag: 'PRIVACY'
  },
  {
    toolId: 'watermark',
    title: 'Custom Text & Logo Watermark',
    desc: 'Overlay proof marks, copyright text, or brand logos with fine opacity control and 5-point grid positioning.',
    icon: 'M7 20l4-16m2 16l4-16M6 9h14M4 15h14',
    tag: 'BRANDING'
  },
  {
    toolId: 'convert',
    title: 'Multi-Format Conversion',
    desc: 'Convert seamlessly between WEBP, AVIF, PNG, JPEG, and PDF with precision quality controls.',
    icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4',
    tag: 'FORMATS'
  },
  {
    toolId: 'ocr',
    title: 'Client OCR Text Scanner',
    desc: 'Scan text embedded in images directly on the browser canvas without third-party API calls.',
    icon: 'M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z',
    tag: 'AI UTILITY'
  },
  {
    toolId: 'borders',
    title: 'DPI & Canvas Control',
    desc: 'Adjust outer padding margins, background fills, and canvas color parameters.',
    icon: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5z',
    tag: 'EXPORT'
  },
  {
    toolId: 'compress',
    title: 'Image Compressor',
    desc: 'Reduce file size up to 90% with precision lossy or lossless compression sliders.',
    icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
    tag: 'OPTIMIZATION'
  }
