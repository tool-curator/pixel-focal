---

<section id="features" class="py-20 md:py-28 border-b theme-border theme-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="px-3.5 py-1 text-xs font-semibold tracking-wider text-blue-500 bg-blue-500/10 border border-blue-500/20 rounded-full uppercase">
        COMPLETE FEATURE SUITE
      </span>
      <h2 class="mt-4 text-3xl sm:text-5xl font-extrabold theme-heading tracking-tight">
        Engineered for speed, privacy, and precision.
      </h2>
      <p class="mt-4 text-base sm:text-lg theme-body">
        Click any feature card below to immediately open that tool in your workspace studio.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featureList.map(f => (
        <a href="#workspace" data-tool-select={f.toolId} class="feature-card-redirect group relative p-6 rounded-2xl theme-card border theme-border hover:border-blue-500/60 transition-all duration-300 hover:-translate-y-1 shadow-md hover:shadow-blue-500/10 flex flex-col justify-between cursor-pointer">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="p-3 rounded-xl bg-blue-600/10 border border-blue-500/20 text-blue-500 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={f.icon} />
                </svg>
              </div>
              <span class="text-[10px] font-mono font-semibold theme-muted group-hover:text-blue-500 tracking-wider uppercase flex items-center gap-1">
                {f.tag}
                <svg class="w-3 h-3 text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </span>
            </div>
            <h3 class="text-lg font-bold theme-heading mb-2 group-hover:text-blue-500 transition-colors">{f.title}</h3>
            <p class="text-sm theme-body leading-relaxed">{f.desc}</p>
          </div>
          <div class="mt-4 pt-3 border-t theme-border flex items-center justify-between text-xs font-semibold text-blue-500">
            <span>Open Tool in Workspace</span>
            <span class="text-base group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('.feature-card-redirect').forEach(card => {
    card.addEventListener('click', (e) => {
      const toolId = card.getAttribute('data-tool-select');
      if (toolId && window.pixelEditor) {
        window.pixelEditor.setTool(toolId);
      }
    });
  });
</script>
