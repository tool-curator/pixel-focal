        <div>
          <label class="block text-xs font-medium theme-muted mb-1">Outer Padding (px)</label>
          <input type="number" id="paddingInput" value="0" min="0" max="200" class="w-full px-3 py-2 rounded-lg theme-input border theme-border theme-heading font-mono text-xs focus:border-blue-500 focus:outline-none" />
        </div>
        <div>
          <label class="block text-xs font-medium theme-muted mb-1">Background Fill Color</label>
          <input type="color" id="bgColorInput" value="#000000" class="w-full h-10 rounded-lg theme-input border theme-border cursor-pointer" />
        </div>
      </div>

      <!-- TOOL 14: BACKGROUND REMOVAL -->
      <div class="tool-inspector-panel hidden space-y-4" data-panel="bgremove">
        <div class="pb-3 border-b theme-border">
          <h3 class="text-base font-bold theme-heading">AI Background Remover</h3>
          <p class="text-xs theme-muted">Client-side segmenter model (In Development).</p>
        </div>
        <div class="p-3 rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-500 text-xs">
          ⚡ AI Background Remover runs 100% locally via WebAssembly ONNX runtime in upcoming v2.1 update.
        </div>
      </div>
    </div>
  </div>

  <!-- Dock Component -->
  <ToolDock />

  <!-- Global Progress Bar Overlay -->
  <div id="globalProgressOverlay" class="hidden fixed inset-0 z-[120] bg-black/70 backdrop-blur-md flex flex-col items-center justify-center text-white transition-all">
    <div class="w-80 max-w-[90vw] p-6 rounded-2xl theme-card border theme-border shadow-2xl space-y-4 text-center">
      <div class="w-12 h-12 mx-auto rounded-full bg-blue-600/20 border border-blue-500 text-blue-500 flex items-center justify-center animate-spin">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
      </div>
