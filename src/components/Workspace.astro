        </div>
        <div id="paletteColorsGrid" class="grid grid-cols-3 gap-2"></div>
      </div>

      <!-- TOOL 9: OCR SCANNER -->
      <div class="tool-inspector-panel hidden space-y-4" data-panel="ocr">
        <div class="pb-3 border-b theme-border">
          <h3 class="text-base font-bold theme-heading">OCR Text Detection</h3>
          <p class="text-xs theme-muted">Extract embedded text directly from pixels.</p>
        </div>
        <textarea id="ocrOutputText" rows="6" readonly class="w-full p-3 rounded-lg theme-input border theme-border font-mono text-xs theme-heading focus:outline-none"></textarea>
      </div>

      <!-- TOOL 10: RESPONSIVE CODE -->
      <div class="tool-inspector-panel hidden space-y-4" data-panel="responsive">
        <div class="pb-3 border-b theme-border">
          <h3 class="text-base font-bold theme-heading">Developer Code Generator</h3>
          <p class="text-xs theme-muted">Production markup for HTML, Next.js, Astro, React, and Vue.</p>
        </div>
        <div class="flex flex-wrap gap-1 theme-input p-1 rounded-lg border theme-border">
          <button data-fw="html-picture" class="code-fw-btn px-2.5 py-1 text-[11px] font-medium rounded-md bg-blue-600 text-white">HTML</button>
          <button data-fw="nextjs" class="code-fw-btn px-2.5 py-1 text-[11px] font-medium rounded-md theme-muted hover:text-blue-500">Next.js</button>
          <button data-fw="astro" class="code-fw-btn px-2.5 py-1 text-[11px] font-medium rounded-md theme-muted hover:text-blue-500">Astro</button>
          <button data-fw="react" class="code-fw-btn px-2.5 py-1 text-[11px] font-medium rounded-md theme-muted hover:text-blue-500">React</button>
          <button data-fw="vue" class="code-fw-btn px-2.5 py-1 text-[11px] font-medium rounded-md theme-muted hover:text-blue-500">Vue</button>
        </div>
        <pre class="p-3 rounded-lg theme-input border theme-border overflow-x-auto text-[11px] font-mono text-blue-500"><code id="responsiveCodeBlock">Upload image to generate snippet...</code></pre>
        <button id="copyCodeSnippetBtn" class="w-full py-2 text-xs font-semibold rounded-lg bg-blue-600 hover:bg-blue-500 text-white active:scale-95 transition-all">Copy Code Snippet</button>
      </div>

      <!-- TOOL 11: BATCH QUEUE -->
      <div class="tool-inspector-panel hidden space-y-4" data-panel="batch">
        <div class="pb-3 border-b theme-border">
          <h3 class="text-base font-bold theme-heading">Batch Queue Manager</h3>
          <p class="text-xs theme-muted">Process multiple images in a single batch archive.</p>
        </div>
        <div id="batchQueueList" class="space-y-2 max-h-60 overflow-y-auto"></div>
      </div>

      <!-- TOOL 12: FILTERS & FX -->
      <div class="tool-inspector-panel hidden space-y-4" data-panel="filters">
        <div class="pb-3 border-b theme-border">
          <h3 class="text-base font-bold theme-heading">Canvas Filters & FX</h3>
