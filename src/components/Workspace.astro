      </div>
      <div class="w-full h-2 rounded-full bg-zinc-800 overflow-hidden">
        <div id="globalProgressBar" class="h-full bg-gradient-to-r from-blue-600 to-indigo-500 transition-all duration-200" style="width: 0%;"></div>
      </div>
      <div class="text-xs font-mono theme-muted text-right"><span id="globalProgressText">0%</span></div>
    </div>
