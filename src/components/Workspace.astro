          <svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
          Advanced Export Settings
        </h3>
        <button onclick="document.getElementById('advancedExportModal')?.classList.add('hidden')" class="p-1 rounded-lg theme-muted hover:theme-heading text-sm">✕</button>
      </div>

      <div class="space-y-4 text-xs">
        <div>
          <label class="block font-semibold theme-heading mb-1.5">Output Format</label>
          <select id="advExportFormat" class="w-full px-3 py-2 rounded-xl theme-input border theme-border theme-heading font-medium">
            <option value="image/png">PNG (Lossless, Transparency)</option>
            <option value="image/jpeg" selected>JPEG (High Compatibility)</option>
            <option value="image/webp">WebP (Next-Gen Web)</option>
            <option value="image/avif">AVIF (Ultra High Compression)</option>
            <option value="image/svg+xml">SVG Vector Wrapper</option>
            <option value="application/pdf">PDF Document</option>
          </select>
        </div>

        <div>
          <div class="flex justify-between font-semibold theme-heading mb-1.5">
            <span>Compression Level</span>
            <span id="advQualityVal" class="text-blue-500 font-mono">15% (85% Quality)</span>
          </div>
          <input type="range" id="advExportQuality" min="0" max="95" value="15" class="w-full cursor-pointer" oninput="
            const comp = parseInt(this.value);
            const qual = Math.max(5, 100 - comp);
            document.getElementById('advQualityVal').textContent = comp + '% (' + qual + '% Quality)';
          " />
          <div class="flex justify-between text-[10px] theme-muted mt-1 font-mono">
            <span>0% (Max Quality & Size)</span>
            <span>95% (High Compression, Min Size)</span>
          </div>
        </div>

        <div>
          <label class="block font-semibold theme-heading mb-1.5">Resolution / Resize Scale</label>
          <div class="grid grid-cols-4 gap-2">
            <button type="button" class="adv-scale-btn px-2.5 py-1.5 rounded-lg border border-blue-500 bg-blue-500/10 text-blue-500 font-bold" data-scale="100">100%</button>
            <button type="button" class="adv-scale-btn px-2.5 py-1.5 rounded-lg theme-input border theme-border theme-heading" data-scale="75">75%</button>
            <button type="button" class="adv-scale-btn px-2.5 py-1.5 rounded-lg theme-input border theme-border theme-heading" data-scale="50">50%</button>
            <button type="button" class="adv-scale-btn px-2.5 py-1.5 rounded-lg theme-input border theme-border theme-heading" data-scale="25">25%</button>
          </div>
        </div>

        <div class="pt-2 border-t theme-border space-y-2">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="advKeepExif" checked class="rounded border-zinc-700 text-blue-600 focus:ring-0" />
            <span class="theme-heading font-medium">Strip EXIF metadata for security & privacy</span>
          </label>
        </div>
      </div>

      <div class="pt-3 border-t theme-border flex items-center justify-end gap-2">
        <button onclick="document.getElementById('advancedExportModal')?.classList.add('hidden')" class="px-4 py-2 text-xs font-semibold theme-input rounded-xl theme-heading">Cancel</button>
        <button onclick="
          const fmt = document.getElementById('advExportFormat')?.value;
          const comp = parseInt(document.getElementById('advExportQuality')?.value || '15');
          const qual = Math.max(5, 100 - comp);
          const scale = parseInt(document.querySelector('.adv-scale-btn.border-blue-500')?.getAttribute('data-scale') || '100');
          window.pixelEditor?.exportWithAdvancedSettings({ format: fmt, quality: qual, scalePercent: scale });
          document.getElementById('advancedExportModal')?.classList.add('hidden');
        " class="px-5 py-2 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-500 rounded-xl shadow-lg transition-all">
          Download Export
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.adv-scale-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.adv-scale-btn').forEach(b => {
            b.classList.remove('border-blue-500', 'bg-blue-500/10', 'text-blue-500', 'font-bold');
            b.classList.add('theme-input', 'theme-border', 'theme-heading');
          });
          btn.classList.add('border-blue-500', 'bg-blue-500/10', 'text-blue-500', 'font-bold');
          btn.classList.remove('theme-input', 'theme-border', 'theme-heading');
        });
      });
    });
  </script>
</section>
