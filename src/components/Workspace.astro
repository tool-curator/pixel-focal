        <div>
          <label class="block text-xs font-medium theme-muted mb-1">Brightness</label>
          <input type="range" id="brightnessInput" min="0" max="200" value="100" class="w-full" />
        </div>
        <div>
          <label class="block text-xs font-medium theme-muted mb-1">Contrast</label>
          <input type="range" id="contrastInput" min="0" max="200" value="100" class="w-full" />
        </div>
        <div>
          <label class="block text-xs font-medium theme-muted mb-1">Saturation</label>
          <input type="range" id="saturationInput" min="0" max="200" value="100" class="w-full" />
        </div>
        <div>
          <label class="block text-xs font-medium theme-muted mb-1">Blur (px)</label>
          <input type="range" id="blurInput" min="0" max="20" value="0" class="w-full" />
        </div>
      </div>

      <!-- TOOL 13: BORDERS & CANVAS -->
      <div class="tool-inspector-panel hidden space-y-4" data-panel="borders">
        <div class="pb-3 border-b theme-border">
          <h3 class="text-base font-bold theme-heading">Borders & Padding</h3>
          <p class="text-xs theme-muted">Outer padding margins and background canvas fill.</p>
