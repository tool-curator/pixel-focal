      <div class="flex items-center justify-between pb-3 border-b theme-border">
        <h3 class="text-lg font-bold theme-heading flex items-center gap-2">
          <svg class="w-5 h-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Edit Action History
        </h3>
        <button onclick="document.getElementById('historyModal')?.classList.add('hidden')" class="p-1 rounded-lg theme-muted hover:theme-heading text-sm">✕</button>
      </div>
      <div id="historyListContainer" class="space-y-2 max-h-80 overflow-y-auto">
        <div class="p-6 text-center text-xs theme-muted">No edit history recorded yet.</div>
      </div>
      <div class="pt-3 border-t theme-border flex justify-end">
        <button onclick="document.getElementById('historyModal')?.classList.add('hidden')" class="px-4 py-2 text-xs font-semibold theme-input rounded-xl theme-heading">Close</button>
      </div>
    </div>
  </div>

  <!-- Recent Files Modal -->
  <div id="recentFilesModal" class="hidden fixed inset-0 z-[110] bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-2xl theme-card border theme-border shadow-2xl p-6 space-y-4">
      <div class="flex items-center justify-between pb-3 border-b theme-border">
