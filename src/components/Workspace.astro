---
import ToolDock from './ToolDock.astro';

const socialPresets = [
  { label: 'Instagram Square (1080x1080)', value: '1080x1080' },
  { label: 'Instagram Portrait (1080x1350)', value: '1080x1350' },
  { label: 'Instagram Story (1080x1920)', value: '1080x1920' },
  { label: 'YouTube Thumbnail (1280x720)', value: '1280x720' },
  { label: 'YouTube Banner (2560x1440)', value: '2560x1440' },
  { label: 'LinkedIn Post (1200x628)', value: '1200x628' },
  { label: 'X / Twitter Post (1600x900)', value: '1600x900' },
  { label: 'X / Twitter Header (1500x500)', value: '1500x500' },
  { label: 'TikTok Video Cover (1080x1920)', value: '1080x1920' },
  { label: 'Pinterest Pin (1000x1500)', value: '1000x1500' },
  { label: 'Discord Banner (600x240)', value: '600x240' },
];
---

<section id="workspace" class="relative max-w-[1600px] w-full mx-auto px-4 sm:px-6 lg:px-10 py-16 md:py-24">
  <!-- Global Full-Screen Drag & Drop Overlay -->
  <div id="globalDragOverlay" class="hidden fixed inset-0 z-[100] bg-blue-900/80 backdrop-blur-md border-4 border-dashed border-white flex flex-col items-center justify-center text-white pointer-events-none transition-all">
    <div class="p-6 rounded-full bg-white/10 border border-white/20 mb-4 animate-bounce">
      <svg class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
    </div>
    <h2 class="text-3xl font-extrabold tracking-tight">Drop files anywhere to open & edit</h2>
    <p class="text-sm opacity-80 mt-2">Supports PNG, JPEG, WebP, AVIF, HEIC/HEIF up to 50MB</p>
  </div>

  <!-- Toast Notification -->
  <div id="toastNotification" class="fixed top-20 right-6 z-50 px-4 py-2.5 rounded-xl bg-blue-600 text-white font-medium text-xs shadow-2xl transition-all duration-300 transform translate-y-20 opacity-0 flex items-center gap-2">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
    <span>Action complete</span>
  </div>

  <!-- Quick Onboarding Tips Banner -->
  <div id="onboardingTipsBanner" class="mb-6 p-4 rounded-2xl theme-card border border-blue-500/30 bg-blue-500/5 hidden lg:flex flex-wrap items-center justify-between gap-4 text-xs">
    <div class="flex items-center gap-3">
      <span class="p-2 rounded-xl bg-blue-600/10 text-blue-500 font-bold">💡 Quick Tip</span>
      <p class="theme-heading font-medium">
        Drop images anywhere on the page • Press <kbd class="px-1.5 py-0.5 rounded bg-zinc-800 border border-zinc-700 text-blue-400 font-mono">Ctrl+Z</kbd> to Undo, <kbd class="px-1.5 py-0.5 rounded bg-zinc-800 border border-zinc-700 text-blue-400 font-mono">Ctrl+Y</kbd> to Redo, <kbd class="px-1.5 py-0.5 rounded bg-zinc-800 border border-zinc-700 text-blue-400 font-mono">Ctrl+S</kbd> to Export.
      </p>
    </div>
    <button onclick="document.getElementById('onboardingTipsBanner')?.remove()" class="px-2.5 py-1 rounded-lg theme-input theme-muted hover:theme-heading text-[11px] font-semibold transition-colors">
      Got it ✕
    </button>
  </div>

  <!-- Workspace Header / Status -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b theme-border">
    <div class="flex items-center gap-3">
      <div class="p-2.5 rounded-xl bg-blue-600/10 border border-blue-500/20 text-blue-500">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      </div>
      <div>
        <h2 class="text-xl font-extrabold theme-heading tracking-tight flex items-center gap-2">
          Image Studio Workspace
          <span class="px-2.5 py-0.5 rounded-md bg-blue-500/10 text-blue-500 text-[11px] font-mono border border-blue-500/20 uppercase font-semibold">Local RAM Engine</span>
        </h2>
        <p class="text-xs theme-muted">Select tools on the dock below to apply instant canvas transforms.</p>
      </div>
    </div>

    <!-- Top Action Buttons Bar -->
    <div class="flex flex-wrap items-center gap-2">
      <!-- Undo / Redo Buttons -->
      <div class="flex items-center gap-1 p-1 rounded-xl theme-card border theme-border">
        <button id="undoBtn" disabled title="Undo (Ctrl+Z)" class="p-1.5 rounded-lg theme-heading hover:bg-blue-600/10 disabled:opacity-40 disabled:pointer-events-none transition-all">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
        </button>
        <button id="redoBtn" disabled title="Redo (Ctrl+Y)" class="p-1.5 rounded-lg theme-heading hover:bg-blue-600/10 disabled:opacity-40 disabled:pointer-events-none transition-all">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 10H11a8 8 0 00-8 8v2m18-10l-6 6m6-6l-6-6"/></svg>
        </button>
      </div>

      <!-- View Mode Buttons -->
      <div class="flex items-center gap-1 p-1 rounded-xl theme-card border theme-border">
        <button onclick="window.pixelEditor?.toggleViewMode('single')" title="Single View" class="px-2.5 py-1 text-xs font-semibold theme-heading hover:bg-blue-600/10 rounded-lg transition-all">Single</button>
        <button onclick="window.pixelEditor?.toggleViewMode('side-by-side')" title="Side-by-Side View" class="px-2.5 py-1 text-xs font-semibold theme-heading hover:bg-blue-600/10 rounded-lg transition-all">Side-by-Side</button>
        <button onclick="window.pixelEditor?.toggleViewMode('slider')" title="Interactive Split Slider" class="px-2.5 py-1 text-xs font-semibold text-blue-500 hover:bg-blue-600/10 rounded-lg transition-all">Slider</button>
      </div>

      <!-- History & Recent Files Modal Triggers -->
      <button onclick="document.getElementById('historyModal')?.classList.remove('hidden')" class="px-3 py-2 text-xs font-semibold theme-card border theme-border rounded-xl active:scale-95 transition-all flex items-center gap-1.5 hover:border-blue-500/40">
        <svg class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        History
      </button>

      <button onclick="document.getElementById('recentFilesModal')?.classList.remove('hidden')" class="px-3 py-2 text-xs font-semibold theme-card border theme-border rounded-xl active:scale-95 transition-all flex items-center gap-1.5 hover:border-purple-500/40">
        <svg class="w-4 h-4 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
        Recent
      </button>

      <button onclick="document.getElementById('advancedExportModal')?.classList.remove('hidden')" class="px-3.5 py-2 text-xs font-semibold theme-card border theme-border rounded-xl active:scale-95 transition-all flex items-center gap-1.5 hover:border-emerald-500/40">
        <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
        Export Options
      </button>

      <label id="editorDropZone" for="imageUploadInput" class="px-4 py-2 text-xs font-bold text-white bg-gradient-to-r from-blue-600 via-blue-500 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 shadow-lg shadow-blue-500/25 border border-blue-400/30 rounded-xl cursor-pointer hover:scale-[1.02] active:scale-95 transition-all flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
        Upload Image
        <input type="file" id="imageUploadInput" multiple accept="image/*,.jpg,.jpeg,.png,.webp,.avif,.heic,.heif,.HEIC,.HEIF,.bmp,.gif" class="hidden" />
      </label>

      <button id="exportPrimaryBtn" class="px-4 py-2 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-500 rounded-xl shadow-lg active:scale-95 transition-all flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        Quick Export
      </button>
    </div>
  </div>

  <!-- Main Editor (60% Workspace / 40% Feature Space Side-by-Side) -->
  <div class="flex flex-col lg:flex-row gap-6 lg:gap-8 items-start pb-32 sm:pb-28 lg:pb-24">

    <!-- LEFT COLUMN: Workspace / Upload Stage (60% Width) -->
    <div class="w-full lg:w-[60%] space-y-4">
      
      <!-- Empty State Upload Dropzone Stage (Upload Space) -->
      <div id="emptyStateDropzone" class="relative min-h-[320px] sm:min-h-[440px] lg:min-h-[540px] rounded-2xl theme-card border-2 border-dashed border-blue-500/40 hover:border-blue-500 flex flex-col items-center justify-center p-5 sm:p-8 text-center transition-all cursor-pointer group shadow-lg">
        <div class="p-4 sm:p-6 rounded-2xl bg-blue-600/10 text-blue-500 border border-blue-500/20 group-hover:scale-110 transition-transform mb-4 sm:mb-6">
          <svg class="w-10 h-10 sm:w-14 sm:h-14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
        </div>

        <h3 class="text-xl sm:text-2xl font-extrabold theme-heading tracking-tight mb-2">
          Drop your image here or browse
        </h3>
        <p class="text-xs sm:text-sm theme-body max-w-md mb-6 sm:mb-8 leading-relaxed">
          100% Client-Side Processing • Your images are processed locally in RAM and never uploaded to any cloud server.
        </p>

        <label for="emptyStateUploadInput" class="px-6 py-3 sm:px-9 sm:py-4 rounded-xl text-sm sm:text-base font-extrabold text-white bg-gradient-to-r from-blue-600 via-blue-500 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 shadow-xl shadow-blue-500/30 border border-blue-400/30 ring-4 ring-blue-500/15 hover:scale-[1.03] active:scale-95 transition-all cursor-pointer flex items-center gap-2.5 sm:gap-3">
          <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Upload Image (Max 50MB)
          <input type="file" id="emptyStateUploadInput" multiple accept="image/*,.jpg,.jpeg,.png,.webp,.avif,.heic,.heif,.HEIC,.HEIF,.bmp,.gif" class="hidden" />
        </label>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-2 text-xs theme-muted font-medium">
          <span class="px-3 py-1.5 rounded-lg theme-input border theme-border font-mono">PNG</span>
          <span class="px-3 py-1.5 rounded-lg theme-input border theme-border font-mono">JPEG</span>
          <span class="px-3 py-1.5 rounded-lg theme-input border theme-border font-mono">WEBP</span>
          <span class="px-3 py-1.5 rounded-lg theme-input border theme-border font-mono">AVIF</span>
          <span class="px-3 py-1.5 rounded-lg theme-input border theme-border font-mono text-blue-500 border-blue-500/30">HEIC / HEIF</span>
          <span class="px-3 py-1.5 rounded-lg theme-input border theme-border font-mono">MAX 50MB</span>
        </div>
      </div>

      <!-- Single Active Preview Stage -->
      <div id="singlePreviewStage" class="hidden relative min-h-[300px] sm:min-h-[420px] lg:min-h-[540px] rounded-2xl theme-card border theme-border overflow-hidden flex flex-col items-center justify-center p-3 sm:p-6">
        <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#3f3f46_1px,transparent_1px)] [background-size:16px_16px]"></div>

        <!-- Stage Container -->
        <div id="previewStageContainer" class="relative max-w-full max-h-[420px] sm:max-h-[560px] lg:max-h-[620px] overflow-hidden rounded-xl border theme-border shadow-2xl flex items-center justify-center">
          
          <!-- Live Canvas Output Image -->
          <img src="" alt="Edited Output" class="processedImageClass max-h-[380px] sm:max-h-[540px] lg:max-h-[600px] w-auto object-contain transition-opacity duration-150" />
          
          <!-- Raw Original Background Layer -->
          <img src="" alt="Original Image" class="originalImageClass absolute inset-0 w-full h-full object-contain pointer-events-none opacity-0 transition-opacity duration-150 z-20" id="rawOriginalOverlayImg" />

          <!-- High-Contrast Badge when Holding Original -->
          <div id="originalHoldingBadge" class="hidden absolute top-3 left-3 sm:top-4 sm:left-4 z-40 px-2.5 py-1.5 sm:px-3.5 sm:py-2 rounded-lg bg-amber-500 text-black font-extrabold text-[10px] sm:text-xs shadow-xl flex items-center gap-1.5 animate-pulse">
            <span>👀 RAW UNEDITED ORIGINAL</span>
          </div>

          <!-- Interactive Freeform Crop Drag Overlay Box -->
          <div id="cropOverlayBox" class="hidden absolute border-2 border-blue-500 bg-blue-500/15 cursor-move shadow-[0_0_0_9999px_rgba(0,0,0,0.65)] z-30 select-none touch-none rounded-sm">
            <!-- 3x3 Rule-of-Thirds Composition Grid -->
            <div class="absolute inset-0 pointer-events-none grid grid-cols-3 grid-rows-3">
              <div class="border-r border-b border-blue-400/30"></div>
              <div class="border-r border-b border-blue-400/30"></div>
              <div class="border-b border-blue-400/30"></div>
              <div class="border-r border-b border-blue-400/30"></div>
              <div class="border-r border-b border-blue-400/30"></div>
              <div class="border-b border-blue-400/30"></div>
              <div class="border-r border-blue-400/30"></div>
              <div class="border-r border-blue-400/30"></div>
              <div></div>
            </div>

            <!-- Corner Dots (4 corners) -->
            <div class="absolute -top-2 -left-2 w-4 h-4 bg-blue-500 border-2 border-white rounded-full shadow-md shadow-blue-500/50 cursor-nwse-resize hover:scale-125 transition-transform touch-none z-10" data-handle="tl" title="Resize Top-Left"></div>
            <div class="absolute -top-2 -right-2 w-4 h-4 bg-blue-500 border-2 border-white rounded-full shadow-md shadow-blue-500/50 cursor-nesw-resize hover:scale-125 transition-transform touch-none z-10" data-handle="tr" title="Resize Top-Right"></div>
            <div class="absolute -bottom-2 -left-2 w-4 h-4 bg-blue-500 border-2 border-white rounded-full shadow-md shadow-blue-500/50 cursor-nesw-resize hover:scale-125 transition-transform touch-none z-10" data-handle="bl" title="Resize Bottom-Left"></div>
            <div class="absolute -bottom-2 -right-2 w-4 h-4 bg-blue-500 border-2 border-white rounded-full shadow-md shadow-blue-500/50 cursor-nwse-resize hover:scale-125 transition-transform touch-none z-10" data-handle="br" title="Resize Bottom-Right"></div>

            <!-- Edge Center Dots (4 edges) -->
            <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-4 h-4 bg-blue-500 border-2 border-white rounded-full shadow-md shadow-blue-500/50 cursor-ns-resize hover:scale-125 transition-transform touch-none z-10" data-handle="t" title="Resize Top"></div>
            <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-4 h-4 bg-blue-500 border-2 border-white rounded-full shadow-md shadow-blue-500/50 cursor-ns-resize hover:scale-125 transition-transform touch-none z-10" data-handle="b" title="Resize Bottom"></div>
            <div class="absolute top-1/2 -translate-y-1/2 -left-2 w-4 h-4 bg-blue-500 border-2 border-white rounded-full shadow-md shadow-blue-500/50 cursor-ew-resize hover:scale-125 transition-transform touch-none z-10" data-handle="l" title="Resize Left"></div>
            <div class="absolute top-1/2 -translate-y-1/2 -right-2 w-4 h-4 bg-blue-500 border-2 border-white rounded-full shadow-md shadow-blue-500/50 cursor-ew-resize hover:scale-125 transition-transform touch-none z-10" data-handle="r" title="Resize Right"></div>

            <!-- Box Middle / Center Dot (Move Handle) -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-5 h-5 bg-blue-600 border-2 border-white rounded-full shadow-lg shadow-blue-600/60 cursor-move hover:scale-125 transition-transform touch-none z-10 flex items-center justify-center group" data-handle="c" title="Move Crop Area">
              <div class="w-1.5 h-1.5 bg-white rounded-full pointer-events-none group-hover:scale-150 transition-transform"></div>
            </div>

            <!-- Live Pixel Dimensions Badge -->
            <div class="absolute bottom-2.5 right-2.5 px-2 py-0.5 sm:px-2.5 sm:py-1 text-[10px] sm:text-[11px] font-mono font-bold bg-black/80 text-white rounded-lg shadow-xl backdrop-blur-md border border-white/20 pointer-events-none z-10 flex items-center gap-1" id="cropBoxDimensionsText">
              400 × 300 px
            </div>
          </div>
        </div>
      </div>

      <!-- Interactive Before/After Split Slider Stage (Hidden by default) -->
      <div id="sliderPreviewStage" class="hidden relative min-h-[300px] sm:min-h-[420px] lg:min-h-[540px] rounded-2xl theme-card border theme-border overflow-hidden flex flex-col items-center justify-center p-3 sm:p-6 select-none">
        <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#3f3f46_1px,transparent_1px)] [background-size:16px_16px]"></div>

        <div id="sliderStageContainer" class="relative max-w-full max-h-[420px] sm:max-h-[560px] lg:max-h-[620px] overflow-hidden rounded-xl border theme-border shadow-2xl flex items-center justify-center cursor-ew-resize touch-none">
          <!-- After / Processed Image (Base) -->
          <img src="" alt="Edited Output" class="processedImageClass max-h-[380px] sm:max-h-[540px] lg:max-h-[600px] w-auto object-contain pointer-events-none" />
          <span class="absolute bottom-3 right-3 sm:bottom-4 sm:right-4 z-10 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-lg bg-emerald-600/90 text-white font-bold text-[10px] sm:text-xs shadow-xl backdrop-blur-md pointer-events-none">
            ⚡ Live Edited Output
          </span>

          <!-- Before / Original Image (Clipped Overlay) -->
          <div id="sliderBeforeClip" class="absolute inset-0 w-full h-full pointer-events-none" style="clip-path: inset(0 50% 0 0);">
            <img src="" alt="Original Image" class="originalImageClass w-full h-full object-contain pointer-events-none" />
            <span class="absolute bottom-3 left-3 sm:bottom-4 sm:left-4 z-10 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-lg bg-blue-600/90 text-white font-bold text-[10px] sm:text-xs shadow-xl backdrop-blur-md pointer-events-none">
              📷 Raw Original Image
            </span>
          </div>

          <!-- Drag Handle Divider Line & Handle Button -->
          <div id="sliderHandleBtn" class="absolute top-0 bottom-0 left-1/2 -translate-x-1/2 z-20 flex items-center justify-center cursor-ew-resize pointer-events-none">
            <div class="w-0.5 h-full bg-white shadow-2xl shadow-blue-500"></div>
            <div class="absolute w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-blue-600 text-white border-2 border-white shadow-2xl flex items-center justify-center transform hover:scale-110 transition-transform">
              <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8M8 12h8M8 17h8" />
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Side-by-Side Comparison Grid (Hidden by default) -->
      <div id="sideBySideGrid" class="hidden grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Original Card -->
        <div class="p-3 sm:p-4 rounded-2xl theme-card border theme-border space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold theme-muted">Original Image</span>
            <span class="px-2 py-0.5 text-[10px] font-mono bg-zinc-700/30 theme-heading rounded">Raw</span>
          </div>
          <div class="h-[280px] sm:h-[420px] flex items-center justify-center rounded-xl bg-black/40 overflow-hidden">
            <img src="" alt="Original Image" class="originalImageClass max-h-[260px] sm:max-h-[400px] w-auto object-contain" />
          </div>
        </div>

        <!-- Edited Card -->
        <div class="p-3 sm:p-4 rounded-2xl theme-card border border-blue-500/40 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-blue-500">Edited Output</span>
            <span class="px-2 py-0.5 text-[10px] font-mono bg-blue-600 text-white rounded">Live Canvas</span>
          </div>
          <div class="h-[280px] sm:h-[420px] flex items-center justify-center rounded-xl bg-black/40 overflow-hidden">
            <img src="" alt="Edited Output" class="processedImageClass max-h-[260px] sm:max-h-[400px] w-auto object-contain" />
          </div>
        </div>
      </div>

      <!-- Preview Footer Bar -->
      <div id="previewFooterBar" class="hidden p-3.5 sm:p-4 rounded-xl theme-card border theme-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4 text-xs theme-body">
        <div class="flex items-center gap-2 overflow-hidden max-w-full">
          <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
          <strong id="activeFileName" class="theme-heading font-medium truncate">file.png</strong>
          <span id="activeFileDetails" class="theme-muted shrink-0">0 × 0 px • 0 MB</span>
        </div>
        <div class="flex flex-wrap items-center gap-3 sm:gap-6">
          <div>Estimated Size: <strong id="estimatedSizeText" class="text-blue-500 font-mono">Calculating...</strong></div>
          <div>Dimensions: <strong id="outputDimensionsText" class="theme-heading font-mono">0 × 0 px</strong></div>
          <div>Queue: <strong id="queueCountText" class="theme-heading">0 Images</strong></div>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: Feature Space / Tool Inspector (40% Width, Reduced Compact Height) -->
    <div id="inspectorPanelSidebar" class="w-full lg:w-[40%] p-5 rounded-2xl theme-card border theme-border space-y-5 shadow-lg transition-all">

      <!-- Batch Upload Queue Box (Visible whenever multiple files are loaded) -->
