---
---
<section id="pricing" class="py-20 md:py-28 border-b theme-border theme-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="px-3.5 py-1 text-xs font-semibold tracking-wider text-blue-500 bg-blue-500/10 border border-blue-500/20 rounded-full uppercase">
        TRANSPARENT MODEL
      </span>
      <h2 class="mt-4 text-3xl sm:text-5xl font-extrabold theme-heading tracking-tight">
        Free & Open Source forever.
      </h2>
      <p class="mt-4 text-base theme-body">
        Pixel Focal is community funded and privacy focused under the MIT License.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <!-- Community Free -->
      <div class="p-8 rounded-2xl theme-card border theme-border flex flex-col justify-between space-y-6">
        <div>
          <span class="text-xs font-bold text-blue-500 font-mono">COMMUNITY TIER</span>
          <div class="mt-4 flex items-baseline gap-2">
            <span class="text-4xl font-extrabold theme-heading">$0</span>
            <span class="text-xs theme-muted">/ forever</span>
          </div>
          <p class="mt-4 text-xs theme-body">Everything you need for personal, web, and commercial projects.</p>
          <ul class="mt-6 space-y-3 text-xs theme-body">
            <li class="flex items-center gap-2">✓ 100% Client-Side WebApp</li>
            <li class="flex items-center gap-2">✓ Unlimited Batch Processing Queue</li>
            <li class="flex items-center gap-2">✓ 20+ Image Editing & Export Tools</li>
            <li class="flex items-center gap-2">✓ Responsive Developer Snippets</li>
            <li class="flex items-center gap-2">✓ EXIF Metadata Sanitizer</li>
          </ul>
        </div>
        <a href="#workspace" class="w-full py-3 text-center text-xs font-semibold rounded-xl bg-blue-600 hover:bg-blue-500 text-white active:scale-95 transition-all">
          Start Editing Free
        </a>
      </div>

      <!-- Pro / Team Self Host -->
      <div class="p-8 rounded-2xl theme-card border border-blue-500/30 flex flex-col justify-between space-y-6 relative overflow-hidden">
        <div class="absolute top-4 right-4 px-2.5 py-1 text-[10px] font-bold bg-blue-500/20 text-blue-500 rounded-full border border-blue-500/30">SELF HOST</div>
        <div>
          <span class="text-xs font-bold text-indigo-500 font-mono">TEAM & ENTERPRISE</span>
          <div class="mt-4 flex items-baseline gap-2">
            <span class="text-4xl font-extrabold theme-heading">Self-Hosted</span>
          </div>
          <p class="mt-4 text-xs theme-body">Deploy on your internal intranet, Vercel, Docker, or Kubernetes infrastructure.</p>
          <ul class="mt-6 space-y-3 text-xs theme-body">
            <li class="flex items-center gap-2">✓ Custom Branding & Logo</li>
            <li class="flex items-center gap-2">✓ Air-Gapped Intranet Compliance</li>
            <li class="flex items-center gap-2">✓ Docker Container Manifests</li>
            <li class="flex items-center gap-2">✓ Priority Technical Support</li>
          </ul>
        </div>
        <a href="#workspace" class="w-full py-3 text-center text-xs font-semibold rounded-xl bg-blue-600 hover:bg-blue-500 text-white active:scale-95 transition-all">
          Launch Workspace
        </a>
      </div>
    </div>
  </div>
</section>
