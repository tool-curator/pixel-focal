---
---
<section class="relative pt-20 pb-24 md:pt-28 md:pb-32 overflow-hidden border-b theme-border theme-bg">
  <!-- Background Glow & Grid Patterns -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900/10 via-transparent to-transparent pointer-events-none"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-blue-500/10 rounded-full blur-[120px] pointer-events-none animate-pulse-glow"></div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center text-center">
    
    <!-- Privacy & Tech Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full theme-card border theme-border backdrop-blur-md mb-8 hover:border-blue-500/30 transition-all cursor-default shadow-sm">
      <span class="flex h-2 w-2 rounded-full bg-blue-500 animate-ping"></span>
      <span class="text-xs font-semibold tracking-wide theme-heading">
        ✨ 100% Client-Side • Privacy First • WebAssembly Powered
      </span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight theme-heading max-w-4xl leading-[1.1] text-balance">
      Everything you need to edit images. <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-500 via-blue-600 to-indigo-500">Right in your browser.</span>
    </h1>

    <!-- Subheading with increased line-height -->
    <p class="mt-6 text-lg sm:text-xl theme-body max-w-2xl text-pretty font-normal leading-loose sm:leading-[1.85] tracking-wide">
      All image processing happens locally on your device. Zero server uploads, zero accounts required, absolute data privacy with lightning-fast HTML5 Canvas and WASM performance.
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href="#workspace" class="px-8 py-4 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-blue-600 via-blue-500 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 shadow-xl shadow-blue-600/30 ring-4 ring-blue-500/20 hover:scale-[1.02] active:scale-95 transition-all flex items-center gap-2.5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
        Start Editing Now
      </a>
      <a href="#features" class="px-7 py-3.5 rounded-xl text-sm font-semibold theme-heading theme-card hover:border-blue-500/50 border theme-border active:scale-95 transition-all flex items-center gap-2">
        Explore Features
        <svg class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </a>
    </div>

    <!-- Trust Badges Strip with Icons and Styled Pills -->
    <div class="mt-16 pt-8 border-t theme-border w-full max-w-5xl flex flex-wrap justify-center items-center gap-3 sm:gap-4 text-xs font-semibold theme-heading">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full theme-card border theme-border shadow-xs hover:border-blue-500/40 hover:text-blue-500 transition-all cursor-default">
        <svg class="w-3.5 h-3.5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <span>100% Client-Side</span>
      </div>
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full theme-card border theme-border shadow-xs hover:border-blue-500/40 hover:text-blue-500 transition-all cursor-default">
        <svg class="w-3.5 h-3.5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        <span>No Sign-Up Required</span>
      </div>
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full theme-card border theme-border shadow-xs hover:border-blue-500/40 hover:text-blue-500 transition-all cursor-default">
        <svg class="w-3.5 h-3.5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        <span>Open Source</span>
      </div>
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full theme-card border theme-border shadow-xs hover:border-blue-500/40 hover:text-blue-500 transition-all cursor-default">
        <svg class="w-3.5 h-3.5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <span>Privacy First</span>
      </div>
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full theme-card border theme-border shadow-xs hover:border-blue-500/40 hover:text-blue-500 transition-all cursor-default">
        <svg class="w-3.5 h-3.5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <span>WASM Powered</span>
      </div>
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full theme-card border theme-border shadow-xs hover:border-blue-500/40 hover:text-blue-500 transition-all cursor-default">
        <svg class="w-3.5 h-3.5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
        <span>Batch Processing</span>
      </div>
    </div>
  </div>
</section>
