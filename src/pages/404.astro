---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
---

<Layout
	title="404 - Page Not Found • Pixel Focal"
	description="The page you are looking for does not exist or has been moved. Explore Pixel Focal's browser image editing tools."
	robots="noindex, follow"
>
	<JsonLd type="homepage" />
	<Header />

	<main class="min-h-[75vh] py-20 theme-bg border-b theme-border flex items-center justify-center relative overflow-hidden">
		<!-- Background Glow Accents -->
		<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-tr from-blue-600/10 via-purple-600/10 to-indigo-600/10 rounded-full blur-3xl pointer-events-none"></div>

		<div class="max-w-2xl mx-auto px-4 sm:px-6 text-center space-y-8 relative z-10">
			<!-- 404 Glowing Badge -->
			<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-500 text-xs font-mono font-bold tracking-wider uppercase">
				<span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
				404 ERROR
			</div>

			<div class="space-y-4">
				<h1 class="text-6xl sm:text-8xl font-black theme-heading tracking-tight bg-gradient-to-r from-blue-500 via-indigo-400 to-purple-500 bg-clip-text text-transparent">
					404
				</h1>
				<h2 class="text-2xl sm:text-3xl font-extrabold theme-heading tracking-tight">
					Page Not Found
				</h2>
				<p class="text-sm sm:text-base theme-body max-w-lg mx-auto leading-relaxed">
					Oops! The pixel coordinates you're looking for don't exist, have been renamed, or moved. Let's get you back to editing!
				</p>
			</div>

			<!-- Quick Nav Action Buttons -->
			<div class="flex flex-wrap items-center justify-center gap-3 pt-4">
				<a
					href="/"
					class="px-6 py-3 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-blue-600 via-blue-500 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 shadow-xl shadow-blue-500/25 border border-blue-400/30 hover:scale-[1.02] active:scale-95 transition-all flex items-center gap-2"
				>
					<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
					Back to Home
				</a>

				<a
					href="/#workspace"
					class="px-6 py-3 rounded-xl text-xs font-bold theme-card border theme-border theme-heading hover:border-blue-500/40 active:scale-95 transition-all flex items-center gap-2"
				>
					<svg class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
					Open Studio Workspace
				</a>

				<a
					href="/contact"
					class="px-6 py-3 rounded-xl text-xs font-bold theme-card border theme-border theme-muted hover:theme-heading hover:border-purple-500/40 active:scale-95 transition-all flex items-center gap-2"
				>
					Contact Support →
				</a>
			</div>

			<!-- Quick Tool Links Grid -->
			<div class="pt-8 max-w-xl mx-auto border-t theme-border text-left">
				<span class="text-[11px] font-mono font-bold text-blue-500 uppercase tracking-wider block mb-3 text-center">
					Popular Utility Tools
				</span>
				<div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
					<a href="/tools/image-resizer" class="p-2.5 rounded-xl theme-card border theme-border hover:border-blue-500/50 text-xs theme-heading font-medium flex items-center gap-2 transition-all">
						<span>📐</span> Image Resizer
					</a>
					<a href="/tools/image-cropper" class="p-2.5 rounded-xl theme-card border theme-border hover:border-blue-500/50 text-xs theme-heading font-medium flex items-center gap-2 transition-all">
						<span>✂️</span> Image Cropper
					</a>
					<a href="/tools/image-compressor" class="p-2.5 rounded-xl theme-card border theme-border hover:border-blue-500/50 text-xs theme-heading font-medium flex items-center gap-2 transition-all">
						<span>⚡</span> Compressor
					</a>
					<a href="/tools/image-converter" class="p-2.5 rounded-xl theme-card border theme-border hover:border-blue-500/50 text-xs theme-heading font-medium flex items-center gap-2 transition-all">
						<span>🔄</span> Format Converter
					</a>
					<a href="/tools/batch-image-editor" class="p-2.5 rounded-xl theme-card border theme-border hover:border-blue-500/50 text-xs theme-heading font-medium flex items-center gap-2 transition-all">
						<span>📦</span> Batch Editor
					</a>
					<a href="/tools/color-palette-extractor" class="p-2.5 rounded-xl theme-card border theme-border hover:border-blue-500/50 text-xs theme-heading font-medium flex items-center gap-2 transition-all">
						<span>🎨</span> Palette Generator
					</a>
				</div>
			</div>
		</div>
	</main>

	<Footer />
</Layout>
