---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
---

<Layout
	title="Contact Us • Pixel Focal"
	description="Get in touch with the Pixel Focal team for technical support, feature requests, or privacy inquiries."
>
	<JsonLd type="homepage" />
	<Header />

	<main class="py-16 theme-bg border-b theme-border">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
			
			<!-- Breadcrumb -->
			<nav class="flex items-center gap-2 text-xs theme-muted" aria-label="Breadcrumb">
				<a href="/" class="hover:text-blue-500 transition-colors">Home</a>
				<span>/</span>
				<span class="theme-heading font-medium">Contact Us</span>
			</nav>

			<!-- Header -->
			<div class="space-y-4">
				<span class="px-3.5 py-1 text-xs font-semibold tracking-wider text-blue-500 bg-blue-500/10 border border-blue-500/20 rounded-full uppercase">
					GET IN TOUCH
				</span>
				<h1 class="text-3xl sm:text-5xl font-extrabold theme-heading tracking-tight">
					Contact Us
				</h1>
				<p class="text-base theme-body max-w-xl">
					Have questions, feedback, or feature requests? We'd love to hear from you. Send us a message and our team will get back to you.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-12 gap-8 pt-4">
				
				<!-- Contact Form (7 Cols) -->
				<div class="md:col-span-7 p-6 rounded-2xl theme-card border theme-border space-y-6">
					<h2 class="text-lg font-bold theme-heading">Send a Message</h2>
					
					<form id="contactForm" action="https://formsubmit.co/pixelfocal.support@gmail.com" method="POST" class="space-y-4">
						<input type="hidden" name="_captcha" value="false" />
						<input type="hidden" name="_template" value="table" />
						<div>
							<label for="contactName" class="block text-xs font-medium theme-muted mb-1">Your Name</label>
							<input type="text" id="contactName" name="name" required placeholder="Alex Morgan" class="w-full px-3.5 py-2.5 rounded-xl theme-input border theme-border theme-heading text-xs focus:border-blue-500 focus:outline-none" />
						</div>

						<div>
							<label for="contactEmail" class="block text-xs font-medium theme-muted mb-1">Email Address</label>
							<input type="email" id="contactEmail" name="email" required placeholder="alex@example.com" class="w-full px-3.5 py-2.5 rounded-xl theme-input border theme-border theme-heading text-xs focus:border-blue-500 focus:outline-none" />
						</div>

						<div>
							<label for="contactSubject" class="block text-xs font-medium theme-muted mb-1">Subject</label>
							<select id="contactSubject" name="_subject" class="w-full px-3.5 py-2.5 rounded-xl theme-input border theme-border theme-heading text-xs focus:border-blue-500 focus:outline-none">
								<option value="PixelFocal General Inquiry">General Inquiry</option>
								<option value="PixelFocal Feature Request">Feature Request</option>
								<option value="PixelFocal Bug Report">Report a Bug / Issue</option>
								<option value="PixelFocal Security Inquiry">Security & Privacy Inquiry</option>
							</select>
						</div>

						<div>
							<label for="contactMessage" class="block text-xs font-medium theme-muted mb-1">Message</label>
							<textarea id="contactMessage" name="message" rows="5" required placeholder="How can we help you?" class="w-full p-3.5 rounded-xl theme-input border theme-border theme-heading text-xs focus:border-blue-500 focus:outline-none"></textarea>
						</div>

						<button type="submit" id="contactSubmitBtn" class="w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shadow-lg shadow-blue-600/20 active:scale-95 transition-all">
							Send Message
						</button>
					</form>
				</div>

				<!-- Info Cards Sidebar (5 Cols) -->
				<div class="md:col-span-5 space-y-6">
					
					<div class="p-6 rounded-2xl theme-card border theme-border space-y-3">
						<div class="w-10 h-10 rounded-xl bg-blue-600/10 text-blue-500 border border-blue-500/20 flex items-center justify-center">
							<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
						</div>
						<h3 class="text-sm font-bold theme-heading">Direct Email Support</h3>
						<p class="text-xs theme-body">Reach our core engineering team directly for technical inquiries or bug reports.</p>
						<a href="mailto:pixelfocal.support@gmail.com" class="text-xs font-mono text-blue-500 hover:underline block">pixelfocal.support@gmail.com</a>
					</div>

					<div class="p-6 rounded-2xl theme-card border theme-border space-y-3">
						<div class="w-10 h-10 rounded-xl bg-emerald-600/10 text-emerald-500 border border-emerald-500/20 flex items-center justify-center">
							<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
						</div>
						<h3 class="text-sm font-bold theme-heading">Security Disclosure</h3>
						<p class="text-xs theme-body">Found a security bug or potential issue? Report disclosures for immediate triage.</p>
						<a href="mailto:security@pixelfocal.com" class="text-xs font-mono text-emerald-500 hover:underline block">security@pixelfocal.com</a>
					</div>

					<div class="p-6 rounded-2xl theme-card border theme-border space-y-3">
						<h3 class="text-sm font-bold theme-heading">Frequently Asked Questions</h3>
						<p class="text-xs theme-body">Looking for quick answers about image processing capabilities or format support?</p>
						<a href="/#faq" class="text-xs font-semibold text-blue-500 hover:underline flex items-center gap-1">
							Read Documentation & FAQ →
						</a>
					</div>

				</div>

			</div>

		</div>
	</main>

	<Footer />

	<script is:inline>
		document.getElementById('contactForm')?.addEventListener('submit', async function(e) {
			e.preventDefault();
			const btn = document.getElementById('contactSubmitBtn');
			if (btn) {
				btn.disabled = true;
				btn.textContent = 'Sending Message...';
			}

			const name = document.getElementById('contactName')?.value || '';
			const email = document.getElementById('contactEmail')?.value || '';
			const subject = document.getElementById('contactSubject')?.value || 'Inquiry';
			const message = document.getElementById('contactMessage')?.value || '';

			try {
				const response = await fetch('https://formsubmit.co/ajax/pixelfocal.support@gmail.com', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'Accept': 'application/json'
					},
					body: JSON.stringify({
						name: name,
						email: email,
						_subject: `[PixelFocal] ${subject} from ${name}`,
						message: message
					})
				});

				if (response.ok) {
					alert('Thank you! Your message has been sent to pixelfocal.support@gmail.com.');
					e.target.reset();
				} else {
					window.location.href = `mailto:pixelfocal.support@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent('From: ' + name + ' (' + email + ')\n\n' + message)}`;
				}
			} catch (err) {
				window.location.href = `mailto:pixelfocal.support@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent('From: ' + name + ' (' + email + ')\n\n' + message)}`;
			} finally {
				if (btn) {
					btn.disabled = false;
					btn.textContent = 'Send Message';
				}
			}
		});
	</script>
</Layout>
